  "lessons": [
    {
      "id": "fleece",
      "ipa": "iː",
      "word": "sheep",
      "name": "Vowel · FLEECE",
      "guide_es": "Raise the front of the tongue high towards the hard palate. Keep the lips unrounded and spread; contrast sheep with ship.",
      "contrast_id": "kit",
      "contrast_word": "ship",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.06,
            0.05
          ]
        ],
        "lips": "spread"
      },
      "version": "2"
    },
    {
      "id": "kit",
      "ipa": "ɪ",
      "word": "ship",
      "name": "Vowel · KIT",
      "guide_es": "From /iː/, lower and retract the tongue slightly. Keep the jaw relaxed and notice the short vowel quality in ship.",
      "contrast_id": "fleece",
      "contrast_word": "sheep",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.2,
            0.22
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "dress",
      "ipa": "e",
      "word": "bed",
      "name": "Vowel · DRESS",
      "guide_es": "Open the jaw to mid height. Keep the tongue forward and listen for the crisp short vowel in bed.",
      "contrast_id": "trap",
      "contrast_word": "bad",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.16,
            0.49
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "trap",
      "ipa": "æ",
      "word": "bad",
      "name": "Vowel · TRAP",
      "guide_es": "Open the jaw wider than for bed. Keep the front of the tongue forward and low when saying bad.",
      "contrast_id": "dress",
      "contrast_word": "bed",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.1,
            0.85
          ]
        ],
        "lips": "spread"
      },
      "version": "2"
    },
    {
      "id": "palm",
      "ipa": "ɑː",
      "word": "cart",
      "name": "Vowel · PALM",
      "guide_es": "Open the mouth wide and rest the tongue low and back. In this non-rhotic reference, cart has no pronounced /r/ before /t/.",
      "contrast_id": "strut",
      "contrast_word": "cut",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.83,
            0.96
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "lot",
      "ipa": "ɒ",
      "word": "cot",
      "name": "Vowel · LOT",
      "guide_es": "Gently round the lips and pull the tongue low and back. Contrast the short vowel in cot with caught.",
      "contrast_id": "thought",
      "contrast_word": "caught",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.91,
            0.86
          ]
        ],
        "lips": "round"
      },
      "version": "2"
    },
    {
      "id": "thought",
      "ipa": "ɔː",
      "word": "caught",
      "name": "Vowel · THOUGHT",
      "guide_es": "Keep the lips rounded and raise the tongue higher than in cot. Hold the steady long vowel in caught.",
      "contrast_id": "lot",
      "contrast_word": "cot",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.88,
            0.53
          ]
        ],
        "lips": "round"
      },
      "version": "2"
    },
    {
      "id": "foot",
      "ipa": "ʊ",
      "word": "full",
      "name": "Vowel · FOOT",
      "guide_es": "Relax the lips with light rounding. The tongue sits slightly lower and more central than for fool.",
      "contrast_id": "goose",
      "contrast_word": "fool",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.7,
            0.25
          ]
        ],
        "lips": "round"
      },
      "version": "2"
    },
    {
      "id": "goose",
      "ipa": "uː",
      "word": "fool",
      "name": "Vowel · GOOSE",
      "guide_es": "Raise the tongue high and round the lips. In modern Southern British speech, the tongue position may shift notably forward.",
      "contrast_id": "foot",
      "contrast_word": "full",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.61,
            0.06
          ]
        ],
        "lips": "round"
      },
      "version": "2"
    },
    {
      "id": "strut",
      "ipa": "ʌ",
      "word": "cut",
      "name": "Vowel · STRUT",
      "guide_es": "Open the jaw moderately with neutral, unrounded lips. Listen to the short stressed vowel in cut.",
      "contrast_id": "palm",
      "contrast_word": "cart",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.49,
            0.72
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "nurse",
      "ipa": "ɜː",
      "word": "bird",
      "name": "Vowel · NURSE",
      "guide_es": "Hold the tongue in the centre of the mouth with relaxed lips while sustaining the stressed vowel in bird.",
      "contrast_id": "schwa",
      "contrast_word": "about",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.5,
            0.47
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "schwa",
      "ipa": "ə",
      "word": "about",
      "name": "Vowel · SCHWA",
      "guide_es": "Listen to the opening syllable of about. Release muscular effort and let the tongue rest near the centre in this unstressed syllable.",
      "contrast_id": "nurse",
      "contrast_word": "bird",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.47,
            0.53
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "face",
      "ipa": "eɪ",
      "word": "late",
      "name": "Diphthong · FACE",
      "guide_es": "Begin with the tongue mid-front and glide upwards towards /ɪ/. Blend both targets smoothly inside one syllable.",
      "contrast_id": "price",
      "contrast_word": "light",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.13,
            0.49
          ],
          [
            0.18,
            0.18
          ]
        ],
        "lips": "spread"
      },
      "version": "2"
    },
    {
      "id": "price",
      "ipa": "aɪ",
      "word": "light",
      "name": "Diphthong · PRICE",
      "guide_es": "Start from an open vowel and glide forward and upward. Avoid inserting a break between the two vowel targets.",
      "contrast_id": "face",
      "contrast_word": "late",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.41,
            0.96
          ],
          [
            0.18,
            0.18
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "choice",
      "ipa": "ɔɪ",
      "word": "boy",
      "name": "Diphthong · CHOICE",
      "guide_es": "Begin at the back with rounded lips, then glide the tongue forward and up as lip rounding relaxes.",
      "contrast_id": "price",
      "contrast_word": "light",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.88,
            0.55
          ],
          [
            0.18,
            0.18
          ]
        ],
        "lips": "round-open"
      },
      "version": "2"
    },
    {
      "id": "goat",
      "ipa": "əʊ",
      "word": "coat",
      "name": "Diphthong · GOAT",
      "guide_es": "Start near the centre with neutral lips and round them as the tongue closes towards /ʊ/. Follow the glide in coat.",
      "contrast_id": "mouth",
      "contrast_word": "cow",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.47,
            0.48
          ],
          [
            0.74,
            0.22
          ]
        ],
        "lips": "to-round"
      },
      "version": "2"
    },
    {
      "id": "mouth",
      "ipa": "aʊ",
      "word": "cow",
      "name": "Diphthong · MOUTH",
      "guide_es": "Open the jaw at the onset, then raise the back of the tongue and round the lips smoothly within a single syllable.",
      "contrast_id": "goat",
      "contrast_word": "coat",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.36,
            0.92
          ],
          [
            0.74,
            0.22
          ]
        ],
        "lips": "to-round"
      },
      "version": "2"
    },
    {
      "id": "near",
      "ipa": "ɪə",
      "word": "near",
      "name": "Diphthong · NEAR",
      "guide_es": "In the diphthongal reading, glide from a near-close front position towards the centre. Many speakers also use a steadier long vowel.",
      "contrast_id": "square",
      "contrast_word": "square",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.18,
            0.2
          ],
          [
            0.49,
            0.51
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "square",
      "ipa": "eə",
      "word": "square",
      "name": "Diphthong · SQUARE",
      "guide_es": "In the diphthongal reading, relax a mid-front vowel towards the centre. Modern Southern British speakers frequently produce a single long vowel.",
      "contrast_id": "near",
      "contrast_word": "near",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.13,
            0.54
          ],
          [
            0.49,
            0.51
          ]
        ],
        "lips": "relaxed"
      },
      "version": "2"
    },
    {
      "id": "cure",
      "ipa": "ʊə",
      "word": "cure",
      "name": "Diphthong · CURE",
      "guide_es": "In the traditional diphthong variant, relax a rounded vowel towards the centre. Many speakers instead use a single long vowel, often /ɔː/.",
      "contrast_id": "thought",
      "contrast_word": "caught",
      "diagram": {
        "kind": "vowel",
        "points": [
          [
            0.72,
            0.23
          ],
          [
            0.49,
            0.51
          ]
        ],
        "lips": "round-open"
      },
      "version": "2"
    },
    {
      "id": "p",
      "ipa": "p",
      "word": "pin",
      "name": "bilabial stop",
      "guide_es": "Press both lips together to build brief air pressure, then release. At the start of stressed words like pin, a noticeable puff of aspiration is heard.",
      "contrast_id": "b",
      "contrast_word": "bin",
      "diagram": {
        "kind": "consonant",
        "place": "bilabial",
        "manner": "stop",
        "voiced": false
      },
      "version": "2"
    },
    {
      "id": "b",
      "ipa": "b",
      "word": "bin",
      "name": "bilabial stop",
      "guide_es": "Close both lips and release with minimal aspiration. Vocal fold vibration during the closure may be partial in initial position.",
      "contrast_id": "p",
      "contrast_word": "pin",
      "diagram": {
        "kind": "consonant",
        "place": "bilabial",
        "manner": "stop",
        "voiced": true
      },
      "version": "2"
    },
    {
      "id": "t",
      "ipa": "t",
      "word": "tin",
      "name": "alveolar stop",
      "guide_es": "Place the tongue tip firmly against the alveolar ridge just behind the upper teeth, then pull it away cleanly to release the air.",
      "contrast_id": "d",
      "contrast_word": "din",
      "diagram": {
        "kind": "consonant",
        "place": "alveolar",
        "manner": "stop",
        "voiced": false
      },
      "version": "2"
    },
    {
      "id": "d",
      "ipa": "d",
      "word": "din",
      "name": "alveolar stop",
      "guide_es": "Form a brief seal on the alveolar ridge with the tongue tip. Compare its gentler release and voicing with /t/ in tin.",
      "contrast_id": "t",
      "contrast_word": "tin",
      "diagram": {
        "kind": "consonant",
        "place": "alveolar",
        "manner": "stop",
        "voiced": true
      },
      "version": "2"
    },
    {
      "id": "k",
      "ipa": "k",
      "word": "coat",
      "name": "velar stop",
      "guide_es": "Raise the back of the tongue to the soft palate (velum) to block airflow, then drop it to release a clear burst of air.",
      "contrast_id": "g",
      "contrast_word": "goat",
      "diagram": {
        "kind": "consonant",
        "place": "velar",
        "manner": "stop",
        "voiced": false
      },
      "version": "2"
    },
    {
      "id": "g",
      "ipa": "ɡ",
      "word": "goat",
      "name": "velar stop",
      "guide_es": "Seal the airway at the soft palate with the back of the tongue, then release with much less aspiration than at the start of coat.",
      "contrast_id": "k",
      "contrast_word": "coat",
      "diagram": {
        "kind": "consonant",
        "place": "velar",
        "manner": "stop",
        "voiced": true
      },
      "version": "2"
    },
    {
      "id": "f",
      "ipa": "f",
      "word": "fan",
      "name": "labiodental fricative",
      "guide_es": "Rest the lower lip lightly against the upper incisors. Hold a steady stream of air to create continuous voiceless friction.",
      "contrast_id": "v",
      "contrast_word": "van",
      "diagram": {
        "kind": "consonant",
        "place": "labiodental",
        "manner": "fricative",
        "voiced": false
      },
      "version": "2"
    },
    {
      "id": "v",
      "ipa": "v",
      "word": "van",
      "name": "labiodental fricative",
      "guide_es": "Keep the exact same lip-to-teeth contact as for /f/, and engage the vocal folds throughout the friction. Compare fan with van.",
      "contrast_id": "f",
      "contrast_word": "fan",
      "diagram": {
        "kind": "consonant",
        "place": "labiodental",
        "manner": "fricative",
        "voiced": true
      },
      "version": "2"
    },
    {
      "id": "theta",
      "ipa": "θ",
      "word": "thin",
      "name": "dental fricative",
      "guide_es": "Bring the tongue tip close to the biting edge of the upper incisors. Leave a narrow gap for air to escape continuously without stopping it.",
      "contrast_id": "eth",
      "contrast_word": "then",
      "diagram": {
        "kind": "consonant",
        "place": "dental",
        "manner": "fricative",
        "voiced": false
      },
      "version": "2"
    },
    {
      "id": "eth",
      "ipa": "ð",
      "word": "then",
      "name": "dental fricative",
      "guide_es": "Keep a narrow gap between the tongue tip and upper teeth and add vocal fold vibration. Avoid sealing the airflow like a /d/ stop.",
      "contrast_id": "theta",
      "contrast_word": "thin",
      "diagram": {
        "kind": "consonant",
        "place": "dental",
        "manner": "fricative",
        "voiced": true
      },
      "version": "2"
    },
    {
      "id": "s",
      "ipa": "s",
      "word": "sip",
      "name": "alveolar fricative",
      "guide_es": "Bring the tongue blade close to the alveolar ridge and groove a narrow central channel. Listen for the crisp, high-pitched hiss.",
      "contrast_id": "sh",
      "contrast_word": "ship",
      "diagram": {
        "kind": "consonant",
        "place": "alveolar",
        "manner": "fricative",
        "voiced": false
      },
      "version": "2"
    },
    {
      "id": "z",
      "ipa": "z",
      "word": "zip",
      "name": "alveolar fricative",
      "guide_es": "Maintain the exact central groove used for /s/, and add vocal fold vibration to the friction when saying zip.",
      "contrast_id": "s",
      "contrast_word": "sip",
      "diagram": {
        "kind": "consonant",
        "place": "alveolar",
        "manner": "fricative",
        "voiced": true
      },
      "version": "2"
    },
    {
      "id": "sh",
      "ipa": "ʃ",
      "word": "ship",
      "name": "postalveolar fricative",
      "guide_es": "Pull the constriction slightly further back than /s/ and raise the tongue blade. The lips may round and protrude gently.",
      "contrast_id": "s",
      "contrast_word": "sip",
      "diagram": {
        "kind": "consonant",
        "place": "postalveolar",
        "manner": "fricative",
        "voiced": false
      },
      "version": "2"
    },
    {
      "id": "zh",
      "ipa": "ʒ",
